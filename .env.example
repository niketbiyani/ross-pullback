# Dhan API credentials
# Option A: copy your values here
# Option B: leave blank and place this repo next to risk-management/
#           (config.py auto-loads ../risk-management/.env)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Auto token refresh (same as risk-management)
DHAN_PIN=
DHAN_TOTP_SECRET=

# Scanner settings
VOLUME_THRESHOLD=500000    # minimum shares/day to include a symbol
HISTORY_DAYS=20            # warm-up days (seeds MACD/EMA/RSI)
MAX_WORKERS=5              # parallel threads for bootstrap + volume fetch

# Dashboard
SCANNER_PORT=5050
SCANNER_HOST=0.0.0.0
